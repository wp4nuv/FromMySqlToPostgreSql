{
  "name": "wp4nuv/from-mysql-to-postgresql",
  "description": "CLI tool for migrating MySQL databases to PostgreSQL using COPY.",
  "minimum-stability": "stable",
  "license": "proprietary",
  "authors": [
    {
      "name": "Pedro Maldonado",
      "email": "wp4nuv@me.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "migration/FromMySqlToPostgreSql"
    }
  },
  "require": {
    "php": "~8.5.0",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-pdo_pgsql": "*",
    "ext-pgsql": "*",
    "ext-simplexml": "*",
    "monolog/monolog": "^3.12",
    "psr/log": "^3.0",
    "symfony/console": "^7.4",
    "symfony/options-resolver": "^7.4",
    "symfony/process": "^7.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^13.4",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "config": {
    "sort-packages": true
  }
}
